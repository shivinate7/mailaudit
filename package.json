{
  "name": "mail-day-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "TCGplayer order check-in tracker fed by OrderWand CSV exports",
  "scripts": {
    "build": "node build.mjs",
    "check:build": "node build.mjs --check",
    "check:rules": "node build.mjs --check-rules",
    "check:seed": "node build.mjs --check-seed",
    "check:docs": "node check-docs.mjs",
    "test:check-docs": "node test/check-docs.test.mjs",
    "test:check-records": "node test/check-records.test.mjs",
    "test:ci-wiring": "node test/ci-wiring.test.mjs",
    "test:worker": "node worker/core.test.mjs",
    "test:send-key": "node test/send-key.test.mjs",
    "test:view-rules": "node test/view-rules.test.mjs",
    "test:golden": "node test/golden.test.mjs",
    "test:rules": "node test/rules.test.mjs",
    "check:golden": "node scripts/check-golden.mjs",
    "worker:deploy": "cd worker && npx --yes wrangler@4.149.0 deploy",
    "worker:dev": "cd worker && npx --yes wrangler@4.149.0 dev",
    "check:records": "node check-records.mjs",
    "check:screens": "node test/screens.mjs",
    "test": "node test/app.test.mjs && node test/photoget.test.mjs",
    "serve": "node dev-server.mjs",
    "deploy": "npm run build && npm run check:seed && npm test && git switch -c deploy/$(date +%Y%m%d%H%M%S)-$$ && git add index.html native/ManifestKit/Sources/ManifestKit/rules.js && git commit -m \"deploy: rebuild index.html\" && git push -u origin HEAD && gh pr create --fill --base main && git switch -"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
