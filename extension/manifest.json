{
  "manifest_version": 3,
  "name": "MANIFEST orders",
  "version": "1.0.0",
  "description": "Reads your TCGplayer order history from a signed-in tab and adds new orders to your MANIFEST ledger.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://store.tcgplayer.com/*",
    "https://manifestnumberone.shivamsemwal01.workers.dev/*"
  ],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "MANIFEST orders",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
